;; ═══════════════════════════════════════════════════════════════
;; TESTS
;; ═══════════════════════════════════════════════════════════════

(tests product_service

  ;; ── STORE_INSERT + STORE_FIND ──

  (test "create_and_get"
    (setup (RESET_STORE product_store))
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (sku "WDG-001") (name "Widget") (price 9.99) 
              (stock 10) (category "electronics")))
      (ASSERT status 201)
      (ASSERT body.name "Widget")
      (ASSERT body.sku "WDG-001")
      (ASSERT body.active true)
      (ASSERT body.id exists)
      (ASSERT body.created_at exists)
      (CAPTURE body.id → created_id)

      (REQUEST GET "/products/{created_id}")
      (ASSERT status 200)
      (ASSERT body.name "Widget"))
    (clean (RESET_STORE product_store)))

  ;; ── STORE_FIND: not found ──

  (test "get_not_found"
    (run
      (REQUEST GET "/products/00000000-0000-0000-0000-000000000000")
      (ASSERT status 404)
      (ASSERT body.error.type "NOT_FOUND")))

  ;; ── STORE_FIND_BY: buscar por SKU ──

  (test "find_by_sku"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category)
         VALUES ('a0000000-0000-0000-0000-000000000001', 'FIND-SKU', 'FindMe', 25, 10, 'test')"))
    (run
      (REQUEST GET "/products/sku/FIND-SKU")
      (ASSERT status 200)
      (ASSERT body.name "FindMe")
      (ASSERT body.sku "FIND-SKU"))
    (clean (RESET_STORE product_store)))

  (test "find_by_sku_not_found"
    (setup (RESET_STORE product_store))
    (run
      (REQUEST GET "/products/sku/NONEXISTENT")
      (ASSERT status 404)
      (ASSERT body.error.type "NOT_FOUND"))
    (clean (RESET_STORE product_store)))

  ;; ── STORE_FILTER: por categoría con paginación ──

  (test "filter_by_category"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category) VALUES
         ('b0000000-0000-0000-0000-000000000001', 'EL-001', 'Phone',  500, 10, 'electronics'),
         ('b0000000-0000-0000-0000-000000000002', 'EL-002', 'Laptop', 1000, 5, 'electronics'),
         ('b0000000-0000-0000-0000-000000000003', 'CL-001', 'Shirt',  30, 100, 'clothing')"))
    (run
      (REQUEST GET "/products/category/electronics")
      (ASSERT status 200)
      (ASSERT body.data.length 2)
      (ASSERT body.total 2)
      (ASSERT body.page 1))
    (clean (RESET_STORE product_store)))

  (test "filter_by_category_paginated"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category) VALUES
         ('c0000000-0000-0000-0000-000000000001', 'P-01', 'Prod 1', 10, 10, 'bulk'),
         ('c0000000-0000-0000-0000-000000000002', 'P-02', 'Prod 2', 10, 10, 'bulk'),
         ('c0000000-0000-0000-0000-000000000003', 'P-03', 'Prod 3', 10, 10, 'bulk'),
         ('c0000000-0000-0000-0000-000000000004', 'P-04', 'Prod 4', 10, 10, 'bulk'),
         ('c0000000-0000-0000-0000-000000000005', 'P-05', 'Prod 5', 10, 10, 'bulk')"))
    (run
      (REQUEST GET "/products/category/bulk?page=1&limit=2")
      (ASSERT status 200)
      (ASSERT body.data.length 2)
      (ASSERT body.total 5)
      (ASSERT body.total_pages 3)
      (ASSERT body.page 1)

      (REQUEST GET "/products/category/bulk?page=3&limit=2")
      (ASSERT status 200)
      (ASSERT body.data.length 1)
      (ASSERT body.page 3))
    (clean (RESET_STORE product_store)))

  ;; ── STORE_LIST_ALL: con paginación ──

  (test "list_all_paginated"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category) VALUES
         ('d0000000-0000-0000-0000-000000000001', 'A-01', 'A', 10, 10, 'x'),
         ('d0000000-0000-0000-0000-000000000002', 'A-02', 'B', 10, 10, 'x'),
         ('d0000000-0000-0000-0000-000000000003', 'A-03', 'C', 10, 10, 'x')"))
    (run
      (REQUEST GET "/products?page=1&limit=2")
      (ASSERT status 200)
      (ASSERT body.data.length 2)
      (ASSERT body.total 3)
      (ASSERT body.total_pages 2))
    (clean (RESET_STORE product_store)))

  ;; ── STORE_DELETE: regla de negocio ──

  (test "delete_with_stock_rejected"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category)
         VALUES ('e0000000-0000-0000-0000-000000000001', 'DEL-01', 'Stocked', 10, 5, 'test')"))
    (run
      (REQUEST DELETE "/products/e0000000-0000-0000-0000-000000000001"
        (auth true))
      (ASSERT status 422)
      (ASSERT body.error.type "BUSINESS_RULE"))
    (clean (RESET_STORE product_store)))

  (test "delete_success"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category)
         VALUES ('f0000000-0000-0000-0000-000000000001', 'DEL-02', 'NoStock', 10, 0, 'test')"))
    (run
      (REQUEST DELETE "/products/f0000000-0000-0000-0000-000000000001"
        (auth true))
      (ASSERT status 204)

      (REQUEST GET "/products/f0000000-0000-0000-0000-000000000001")
      (ASSERT status 404))
    (clean (RESET_STORE product_store)))

  ;; ── SQL_QUERY: aggregation ──

  (test "stats_by_category"
    (setup
      (RESET_STORE product_store)
      (SQL_SEED product_store
        "INSERT INTO products (id, sku, name, price, stock, category) VALUES
         ('g0000000-0000-0000-0000-000000000001', 'ST-01', 'Phone',  500, 10, 'electronics'),
         ('g0000000-0000-0000-0000-000000000002', 'ST-02', 'Laptop', 1000, 5, 'electronics'),
         ('g0000000-0000-0000-0000-000000000003', 'ST-03', 'Shirt',  30, 100, 'clothing')"))
    (run
      (REQUEST GET "/products/stats"
        (auth true))
      (ASSERT status 200)
      (ASSERT body.length 2))
    (clean (RESET_STORE product_store)))

  ;; ── Validación ──

  (test "create_invalid_price"
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (sku "BAD-01") (name "Bad") (price -5) (stock 0) (category "test")))
      (ASSERT status 400)))

  (test "create_missing_name"
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (sku "BAD-02") (price 10) (stock 0) (category "test")))
      (ASSERT status 400)))

  ;; ── Auth ──

  (test "unauthorized_create"
    (run
      (REQUEST POST "/products"
        (auth false)
        (body (sku "NO-AUTH") (name "NoAuth") (price 1) (stock 0) (category "test")))
      (ASSERT status 401)))

  (test "unauthorized_stats"
    (run
      (REQUEST GET "/products/stats"
        (auth false))
      (ASSERT status 401))))
