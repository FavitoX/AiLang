;; ═══════════════════════════════════════════════════════════════
;; AILang Bytecode — S-expression format
;; Service: product_service (con PostgreSQL provider)
;; Version: 0.8
;; ═══════════════════════════════════════════════════════════════

(service product_service
  (version "0.8")
  (port 8080)
  (on_fiber_crash RESTART_FIBER)
  (on_service_crash NOTIFY_RESTART))

;; ── Schemas ──────────────────────────────────────────────────

(schema Product
  (field id         uuid      (auto_gen))
  (field sku        string    (required) (min 1) (max 50))
  (field name       string    (required) (min 1) (max 200))
  (field price      decimal   (required) (gt 0))
  (field stock      int       (required) (gte 0))
  (field category   string    (required) (min 1) (max 100))
  (field active     bool      (default true))
  (field created_at timestamp (auto_gen))
  (field updated_at timestamp (auto_gen)))

(schema ProductStats
  (field category       string)
  (field product_count  int)
  (field avg_price      decimal)
  (field total_stock    int))

;; ── Provider: PostgreSQL ─────────────────────────────────────

(store product_store
  (provider PostgreSQL)
  (connection CONFIG.db_connection)
  (pool
    (min 5)
    (max 50)
    (idle_timeout (duration 30 seconds)))
  (schema Product)
  (table "products")
  (mapping
    (field id         → column "id"         type "UUID"          default "gen_random_uuid()")
    (field sku        → column "sku"        type "VARCHAR(50)"   not_null unique)
    (field name       → column "name"       type "VARCHAR(200)"  not_null)
    (field price      → column "price"      type "NUMERIC(10,2)" not_null)
    (field stock      → column "stock"      type "INTEGER"       not_null default "0")
    (field category   → column "category"   type "VARCHAR(100)"  not_null)
    (field active     → column "active"     type "BOOLEAN"       not_null default "true")
    (field created_at → column "created_at" type "TIMESTAMPTZ"   not_null default "NOW()")
    (field updated_at → column "updated_at" type "TIMESTAMPTZ"   not_null default "NOW()")))

;; ── Config ───────────────────────────────────────────────────

(config
  (port              int     8080)
  (log_level         enum    (ERROR WARNING INFO DEBUG) INFO)
  (db_connection     secret  "DB_CONNECTION_STRING")
  (jwt_secret        secret  "JWT_SECRET")
  (export_page_size  int     1000))

;; ── Auth ─────────────────────────────────────────────────────

(auth
  (provider jwt)
  (secret_ref jwt_secret))

;; ── CORS ─────────────────────────────────────────────────────

(cors
  (origins "*")
  (methods GET POST PUT DELETE)
  (headers "Content-Type" "Authorization")
  (max_age 3600))

;; ── Rate Limiting ────────────────────────────────────────────

(rate_limit
  (max_rps 200)
  (burst 50)
  (on_limit ERR_RATE_LIMITED))

;; ── Dependencies ─────────────────────────────────────────────

(depends_on product_store CLOCK)

;; ── Routes ───────────────────────────────────────────────────

(route GET    "/products"                handler_list)
(route GET    "/products/category/:cat"  handler_by_category)
(route GET    "/products/sku/:sku"       handler_by_sku)
(route GET    "/products/stats"          handler_stats)
(route GET    "/products/export"         handler_export)
(route GET    "/products/:id"            handler_get)
(route POST   "/products"               handler_create)
(route PUT    "/products/:id"            handler_update)
(route DELETE "/products/:id"            handler_delete)

;; ═══════════════════════════════════════════════════════════════
;; STORE OPERATIONS — CRUD simple
;; 
;; STORE_FIND      → por PK, retorna RESULT(T, NONE)
;; STORE_FIND_BY   → por campo(s), retorna RESULT(T, NONE) 
;; STORE_FILTER    → por filtro, retorna List<T> con paginación
;; STORE_LIST_ALL  → todos, retorna List<T> con paginación
;; STORE_INSERT    → inserta, retorna T
;; STORE_UPDATE    → reemplaza, retorna T
;; STORE_DELETE    → elimina
;;
;; Internamente generan SQL parametrizado (prepared statements).
;; SIEMPRE seguro. No se puede concatenar SQL.
;; ═══════════════════════════════════════════════════════════════

;; ── STORE_LIST_ALL: todos, con paginación ────────────────────

(handler handler_list
  (auth PUBLIC)
  (returns (RESULT (Paginated Product) Error))
  (do
    (READ_QUERY "page"  int → page  (default 1))
    (READ_QUERY "limit" int → limit (default 20))

    ;; Genera:
    ;; SELECT * FROM products 
    ;; LIMIT $1 OFFSET $2
    ;; + SELECT COUNT(*) FROM products
    (STORE_LIST_ALL product_store
      (paginate (page page) (limit limit) (max_limit 100))
      → result)

    ;; result = { data: [...], page: 1, limit: 20, total: 1543, total_pages: 78 }
    (RESPOND 200 result)))

;; ── STORE_FIND: por PK ───────────────────────────────────────

(handler handler_get
  (auth PUBLIC)
  (params (id uuid))
  (returns (RESULT Product Error))
  (do
    (READ_PARAM id uuid → id)

    ;; Genera: SELECT * FROM products WHERE id = $1
    (STORE_FIND product_store id → product)

    (MATCH product
      (OK   (RESPOND 200 product))
      (NONE (ERR_NOT_FOUND "product" id)))))

;; ── STORE_FIND_BY: por campo único, retorna uno o ninguno ────

(handler handler_by_sku
  (auth PUBLIC)
  (params (sku string))
  (returns (RESULT Product Error))
  (do
    (READ_PARAM sku string → sku)

    ;; Genera: SELECT * FROM products WHERE sku = $1 LIMIT 1
    (STORE_FIND_BY product_store
      (where (= sku @sku))
      (param sku string sku)
      → product)

    (MATCH product
      (OK   (RESPOND 200 product))
      (NONE (ERR_NOT_FOUND "product" sku)))))

;; ── STORE_FILTER: por filtro, retorna N con paginación ───────

(handler handler_by_category
  (auth PUBLIC)
  (params (cat string))
  (returns (RESULT (Paginated Product) Error))
  (do
    (READ_PARAM cat string → category)
    (READ_QUERY "page"  int → page  (default 1))
    (READ_QUERY "limit" int → limit (default 20))

    ;; Genera:
    ;; SELECT * FROM products WHERE category = $1 AND active = true
    ;; LIMIT $2 OFFSET $3
    ;; + SELECT COUNT(*) FROM products WHERE category = $1 AND active = true
    (STORE_FILTER product_store
      (where (and (= category @category) (= active true)))
      (param category string category)
      (paginate (page page) (limit limit) (max_limit 100))
      → result)

    ;; result = { data: [...], page: 1, limit: 20, total: 87, total_pages: 5 }
    (RESPOND 200 result)))

;; ── STORE_INSERT ─────────────────────────────────────────────

(handler handler_create
  (auth (requires authenticated))
  (returns (RESULT Product Error))
  (do
    (READ_BODY Product → body)
    (MATCH body
      (ERR (ERR_INVALID_BODY "Product"))
      (OK
        ;; Genera: INSERT INTO products (sku, name, price, stock, category)
        ;;         VALUES ($1, $2, $3, $4, $5) RETURNING *
        (STORE_INSERT product_store body → product)
        (EMIT_EVENT product_created product)
        (RESPOND 201 product)))))

;; ── STORE_UPDATE ─────────────────────────────────────────────

(handler handler_update
  (auth (requires authenticated))
  (params (id uuid))
  (returns (RESULT Product Error))
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND product_store id → existing)
    (MATCH existing
      (NONE (ERR_NOT_FOUND "product" id))
      (OK
        (READ_BODY Product → body)
        (MATCH body
          (ERR (ERR_INVALID_BODY "Product"))
          (OK
            ;; Genera: UPDATE products SET sku=$1, name=$2, price=$3, 
            ;;         stock=$4, category=$5, updated_at=NOW()
            ;;         WHERE id=$6 RETURNING *
            (STORE_UPDATE product_store id body → updated)
            (EMIT_EVENT product_updated updated)
            (RESPOND 200 updated)))))))

;; ── STORE_DELETE ─────────────────────────────────────────────

(handler handler_delete
  (auth (requires authenticated))
  (params (id uuid))
  (returns (RESULT Void Error))
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND product_store id → product)
    (MATCH product
      (NONE (ERR_NOT_FOUND "product" id))
      (OK
        (BRANCH (> product.stock 0)
          (TRUE
            (ERR_BUSINESS_RULE "cannot_delete_with_stock"
              "product has stock > 0"))
          (FALSE
            (STORE_DELETE product_store id)
            (EMIT_EVENT product_deleted id)
            (RESPOND 204)))))))

;; ═══════════════════════════════════════════════════════════════
;; SQL_QUERY — territorio de queries complejas
;; JOINs, aggregations, CTEs, window functions, subqueries
;; SIEMPRE prepared statements. No concatenación de SQL.
;; ═══════════════════════════════════════════════════════════════

(handler handler_stats
  (auth (requires authenticated))
  (returns (RESULT (List ProductStats) Error))
  (do
    (SQL_QUERY product_store
      "SELECT
         category,
         COUNT(*)            AS product_count,
         ROUND(AVG(price),2) AS avg_price,
         SUM(stock)          AS total_stock
       FROM products
       WHERE active = true
       GROUP BY category
       ORDER BY product_count DESC"
      → stats)

    (RESPOND 200 stats)))

;; ═══════════════════════════════════════════════════════════════
;; SQL_STREAM — datasets grandes, cursor/reader
;; No carga todo en memoria. Trae de a batches.
;; ═══════════════════════════════════════════════════════════════

(handler handler_export
  (auth (requires authenticated))
  (returns (RESULT Void Error))
  (do
    (SQL_STREAM product_store
      "SELECT id, sku, name, price, stock, category, created_at
       FROM products
       WHERE active = true
       ORDER BY created_at ASC"
      (batch_size CONFIG.export_page_size)
      → product_stream)

    ;; STREAM_RESPOND: envía como JSON streaming (NDJSON)
    ;; Cada batch se serializa y envía, liberando memoria
    (STREAM_RESPOND 200 product_stream
      (content_type "application/x-ndjson"))))

;; ═══════════════════════════════════════════════════════════════
;; SQL_EXEC — operaciones que no retornan datos
;; ═══════════════════════════════════════════════════════════════

;; Ejemplo: job de limpieza (invocado por scheduler externo)
