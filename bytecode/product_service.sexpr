;; ═══════════════════════════════════════════════════════════════
;; AILang Bytecode — S-expression format v0.1
;; Service: product_service
;; ═══════════════════════════════════════════════════════════════

(service product_service
  (version "0.7")
  (port 8080)
  (on_fiber_crash RESTART_FIBER)
  (on_service_crash NOTIFY_RESTART))

;; ── Schemas ──────────────────────────────────────────────────

(schema Product
  (field id        uuid    (auto_gen))
  (field name      string  (required) (min 1) (max 200))
  (field price     decimal (required) (gt 0))
  (field stock     int     (required) (gte 0)))

;; ── Stores ───────────────────────────────────────────────────

(store product_store
  (type IN_MEMORY)
  (schema Product)
  (index id PRIMARY))

;; ── Config ───────────────────────────────────────────────────

(config
  (port          int     8080)
  (log_level     enum    (ERROR WARNING INFO DEBUG) INFO)
  (jwt_secret    secret  "JWT_SECRET"))

;; ── Auth ─────────────────────────────────────────────────────

(auth
  (provider jwt)
  (secret_ref jwt_secret))

;; ── CORS ─────────────────────────────────────────────────────

(cors
  (origins "*")
  (methods GET POST PUT DELETE)
  (headers "Content-Type" "Authorization")
  (max_age 3600))

;; ── Rate Limiting ────────────────────────────────────────────

(rate_limit
  (max_rps 200)
  (burst 50)
  (on_limit ERR_RATE_LIMITED))

;; ── Dependencies ─────────────────────────────────────────────

(depends_on product_store)

;; ── Routes ───────────────────────────────────────────────────

(route GET    "/products"      handler_list)
(route GET    "/products/:id"  handler_get)
(route POST   "/products"      handler_create)
(route PUT    "/products/:id"  handler_update)
(route DELETE "/products/:id"  handler_delete)

;; ── Handlers ─────────────────────────────────────────────────

(handler handler_list
  (auth PUBLIC)
  (returns (RESULT (List Product) Error))
  (do
    (STORE_LIST_ALL product_store → products)
    (RESPOND 200 products)))

(handler handler_get
  (auth PUBLIC)
  (params (id uuid))
  (returns (RESULT Product Error))
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND product_store id → product)
    (MATCH product
      (OK   (RESPOND 200 product))
      (NONE (ERR_NOT_FOUND "product" id)))))

(handler handler_create
  (auth (requires authenticated))
  (returns (RESULT Product Error))
  (do
    (READ_BODY Product → body)
    (MATCH body
      (ERR (ERR_INVALID_BODY "Product"))
      (OK
        (STORE_INSERT product_store body → product)
        (EMIT_EVENT product_created product)
        (RESPOND 201 product)))))

(handler handler_update
  (auth (requires authenticated))
  (params (id uuid))
  (returns (RESULT Product Error))
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND product_store id → existing)
    (MATCH existing
      (NONE (ERR_NOT_FOUND "product" id))
      (OK
        (READ_BODY Product → body)
        (MATCH body
          (ERR (ERR_INVALID_BODY "Product"))
          (OK
            (STORE_UPDATE product_store id body → updated)
            (EMIT_EVENT product_updated updated)
            (RESPOND 200 updated)))))))

(handler handler_delete
  (auth (requires authenticated))
  (params (id uuid))
  (returns (RESULT Void Error))
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND product_store id → product)
    (MATCH product
      (NONE (ERR_NOT_FOUND "product" id))
      (OK
        (BRANCH (> product.stock 0)
          (TRUE
            (ERR_BUSINESS_RULE "cannot_delete_with_stock"
              "product has stock > 0"))
          (FALSE
            (STORE_DELETE product_store id)
            (EMIT_EVENT product_deleted id)
            (RESPOND 204)))))))

;; ── Tests ────────────────────────────────────────────────────

(tests product_service

  (test "create_and_list"
    (setup)
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (name "Widget") (price 9.99) (stock 10)))
      (ASSERT status 201)
      (ASSERT body.name "Widget")
      (ASSERT body.id exists)
      (CAPTURE body.id → created_id)

      (REQUEST GET "/products")
      (ASSERT status 200)
      (ASSERT body.length >= 1))
    (clean (RESET_STORE product_store)))

  (test "get_not_found"
    (run
      (REQUEST GET "/products/00000000-0000-0000-0000-000000000000")
      (ASSERT status 404)
      (ASSERT body.error.type "NOT_FOUND"))
    (clean (RESET_STORE product_store)))

  (test "create_negative_price"
    (setup)
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (name "Bad") (price -5) (stock 0)))
      (ASSERT status 400))
    (clean (RESET_STORE product_store)))

  (test "delete_with_stock"
    (setup)
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (name "Stocked") (price 10) (stock 5)))
      (ASSERT status 201)
      (CAPTURE body.id → id)

      (REQUEST DELETE "/products/{id}"
        (auth true))
      (ASSERT status 422)
      (ASSERT body.error.type "BUSINESS_RULE"))
    (clean (RESET_STORE product_store)))

  (test "unauthorized_create"
    (run
      (REQUEST POST "/products"
        (auth false)
        (body (name "NoAuth") (price 1) (stock 0)))
      (ASSERT status 401))
    (clean (RESET_STORE product_store)))

  (test "delete_success"
    (run
      (REQUEST POST "/products"
        (auth true)
        (body (name "ToDelete") (price 10) (stock 0)))
      (ASSERT status 201)
      (CAPTURE body.id → id)

      (REQUEST DELETE "/products/{id}"
        (auth true))
      (ASSERT status 204)

      (REQUEST GET "/products/{id}")
      (ASSERT status 404))
    (clean (RESET_STORE product_store))))
