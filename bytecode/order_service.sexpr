;; ═══════════════════════════════════════════════════════════════
;; AILang Bytecode — S-expression format
;; Service: order_service
;; Version: 0.6
;; Converted from: order_service.json
;; ═══════════════════════════════════════════════════════════════

(service order_service
  (version "0.6")
  (port 8081)
  (on_fiber_crash RESTART_FIBER)
  (on_service_crash NOTIFY_RESTART))

;; ── Schemas ──
(schema OrderItem
  (field product_id uuid (required))
  (field product_name string)
  (field quantity int (required) (gt 0))
  (field unit_price decimal)
  (field subtotal decimal))
(schema Order
  (field id uuid (auto_gen))
  (field customer_name string (required) (min 1) (max 200))
  (field items (list OrderItem) (required) (min_items 1))
  (field total decimal)
  (field status enum (default pending) (values pending confirmed cancelled))
  (field created_at timestamp (auto_gen)))
(schema CreateOrderRequest
  (field customer_name string (required) (min 1) (max 200))
  (field items (list CreateOrderItem) (required) (min_items 1)))
(schema CreateOrderItem
  (field product_id uuid (required))
  (field quantity int (required) (gt 0)))

;; ── Stores ──
(store order_store
  (provider IN_MEMORY)
  (schema Order)
  (index id PRIMARY))

;; ── Dependencies ──
(dependencies
  (order_store order_store)
  (product_service
    (type SERVICE_REF)
    (target product_service)
    (base_url_ref ENV.PRODUCT_SERVICE_URL)
    (default "http://localhost:8080")
    (resilience product_service_policy)))

;; ── Auth ──
(auth
  (provider jwt)
  (secret_ref jwt_secret))

;; ── CORS ──
(cors
  (origins "*")
  (methods GET POST PUT)
  (headers Content-Type Authorization)
  (max_age 3600))

;; ── Resilience (policies, events) ──
(resilience
  (_comment "Resilience is MANDATORY for every SERVICE_REF. If not defined, the bytecode does not compile.")
  (policies
    (product_service_policy
      (timeout
        (duration_ms 3000)
        (on_timeout ERR_TIMEOUT))
      (circuit_breaker
        (failure_threshold 5)
        (success_threshold 3)
        (half_open_max_calls 1)
        (reset_timeout_ms 30000)
        (on_open
          (emit_event circuit_open)
          (fallback ERR_UNAVAILABLE))
        (on_half_open
          (emit_event circuit_half_open))
        (on_close
          (emit_event circuit_closed)))
      (retry
        (max_attempts 3)
        (backoff
          (type exponential)
          (initial_ms 100)
          (max_ms 2000))
        (retryable_errors ERR_TIMEOUT ERR_CONNECTION)
        (non_retryable_errors ERR_NOT_FOUND ERR_VALIDATION ERR_BUSINESS_RULE)
        (_comment "IMPORTANT: retry is opt-in PER CALL via idempotent flag. Non-idempotent operations (payments, mutations) must set idempotent: false and will NOT be retried even if the error is retryable."))))
  (events
    (circuit_open
      (data
        (service string)
        (failures int)
        (timestamp timestamp))
      (description "Emitted when circuit breaker opens — other services can react"))
    (circuit_half_open
      (data
        (service string)
        (timestamp timestamp))
      (description "Emitted when circuit breaker allows test requests"))
    (circuit_closed
      (data
        (service string)
        (timestamp timestamp))
      (description "Emitted when circuit breaker fully recovers"))))

;; ── Custom Errors ──
(custom_errors
  (ERR_INSUFFICIENT_STOCK
    (http_status 422)
    (params product_id requested available)
    (message_template "product {product_id} has {available} units but {requested} were requested"))
  (ERR_ORDER_NOT_CANCELLABLE
    (http_status 422)
    (params order_id current_status)
    (message_template "order {order_id} cannot be cancelled (status: {current_status})")))

;; ── Events (definitions + subscriptions) ──
(events
  (definitions
    (order_created
      (schema Order)
      (description "Emitted when a new order is created"))
    (order_cancelled
      (schema Order)
      (description "Emitted when an order is cancelled")))
  (subscriptions
    (item
      (event order_created)
      (handler on_order_created_update_stock))
    (item
      (event order_cancelled)
      (handler on_order_cancelled_restore_stock))))

;; ── Expression Mini-Language Spec ──
(expressions
  (_comment "Mini-language for COMPUTE operations. Typed, validated at compile time.")
  (supported_operators "+" "-" "*" "/" "%")
  (supported_functions round floor ceil min max abs)
  (type_rules
    (decimal * int decimal)
    (decimal + decimal decimal)
    (int + int int)
    (int - int int)))

;; ── Routes ──
(route GET    "/orders" handler_list_orders)
(route GET    "/orders/:id" handler_get_order)
(route POST   "/orders" handler_create_order)
(route PUT    "/orders/:id/cancel" handler_cancel_order)

;; ── Handlers ──
(handler handler_list_orders
  (auth PUBLIC)
  (returns "RESULT(List<Order>, Error)")
  (do
    (STORE_LIST_ALL order_store → orders)
    (RESPOND 200 orders)))

(handler handler_get_order
  (auth PUBLIC)
  (params (id uuid))
  (returns "RESULT(Order, Error)")
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND order_store id → order)
    (MATCH order
          (OK
            (RESPOND 200 order))
          (NONE
            (ERR_NOT_FOUND "order" id)))))

(handler handler_create_order
  (auth (requires authenticated))
  (returns "RESULT(Order, Error)")
  (do
    (READ_BODY CreateOrderRequest → body)
    (MATCH body
          (ERR
            (ERR_INVALID_BODY "CreateOrderRequest"))
          (OK
            (DEFINE_VAR validated_items List<OrderItem> (list))
            (DEFINE_VAR total decimal 0)
            (ITERATE body.items item
                      (CALL_SERVICE product_service
                                    (method GET)
                                    (path "/products/{item.product_id}")
                                    (idempotent true)
                                  → product_result)
                      (MATCH product_result
                                    (ERR
                                      (ERR_NOT_FOUND "product" item.product_id))
                                    (OK
                                      (BRANCH (< product_result.stock item.quantity)
                                                        (TRUE
                                                          (ERR_CUSTOM ERR_INSUFFICIENT_STOCK (product_id item.product_id) (requested item.quantity) (available product_result.stock)))
                                                        (FALSE
                                                          (COMPUTE product_result.price * item.quantity → subtotal)
                                                          (APPEND validated_items
                                                                                (product_id item.product_id)
                                                                                (product_name product_result.name)
                                                                                (quantity item.quantity)
                                                                                (unit_price product_result.price)
                                                                                (subtotal subtotal))
                                                          (COMPUTE total + subtotal → total))))))
            (CONSTRUCT Order
                      (customer_name body.customer_name)
                      (items validated_items)
                      (total total)
                      (status pending)
                    → new_order)
            (STORE_INSERT order_store new_order → order)
            (EMIT_EVENT order_created order)
            (RESPOND 201 order)))))

(handler handler_cancel_order
  (auth (requires authenticated))
  (params (id uuid))
  (returns "RESULT(Order, Error)")
  (do
    (READ_PARAM id uuid → id)
    (STORE_FIND order_store id → order)
    (MATCH order
          (NONE
            (ERR_NOT_FOUND "order" id))
          (OK
            (BRANCH (!= order.status "'pending'")
                      (TRUE
                        (ERR_CUSTOM ERR_ORDER_NOT_CANCELLABLE (order_id id) (current_status order.status)))
                      (FALSE
                        (STORE_UPDATE_FIELDS order_store id ((status cancelled)) → cancelled_order)
                        (EMIT_EVENT order_cancelled cancelled_order)
                        (RESPOND 200 cancelled_order)))))))

(handler on_order_created_update_stock
  (type EVENT_HANDLER)
  (event order_created)
  (do
    (ITERATE event.data.items item
          (CALL_SERVICE product_service
                    (method GET)
                    (path "/products/{item.product_id}")
                    (idempotent true)
                  → current_product)
          (MATCH current_product
                    (ERR
                      (LOG ERROR "Failed to get product {item.product_id} for stock update"))
                    (OK
                      (COMPUTE current_product.stock - item.quantity → new_stock)
                      (CALL_SERVICE product_service
                                    (method PUT)
                                    (path "/products/{item.product_id}")
                                    (idempotent false)
                                    (body (name current_product.name) (price current_product.price) (stock new_stock))
                                  → update_result)
                      (MATCH update_result
                                    (ERR
                                      (LOG ERROR "Failed to update stock for product {item.product_id}"))
                                    (OK
                                      (LOG INFO "Stock updated for product {item.product_id}: -{item.quantity}"))))))))

(handler on_order_cancelled_restore_stock
  (type EVENT_HANDLER)
  (event order_cancelled)
  (do
    (ITERATE event.data.items item
          (CALL_SERVICE product_service
                    (method GET)
                    (path "/products/{item.product_id}")
                    (idempotent true)
                  → current_product)
          (MATCH current_product
                    (ERR
                      (LOG ERROR "Failed to get product {item.product_id} for stock restore"))
                    (OK
                      (COMPUTE current_product.stock + item.quantity → restored_stock)
                      (CALL_SERVICE product_service
                                    (method PUT)
                                    (path "/products/{item.product_id}")
                                    (idempotent false)
                                    (body (name current_product.name) (price current_product.price) (stock restored_stock))
                                  → restore_result)
                      (MATCH restore_result
                                    (ERR
                                      (LOG ERROR "Failed to restore stock for product {item.product_id}"))
                                    (OK
                                      (LOG INFO "Stock restored for product {item.product_id}: +{item.quantity}"))))))))

;; ── Tests (legacy format — preserved as nested tree) ──
(tests
  (_comment "Each test is INDEPENDENT: setup → run → clean. No test depends on another. Tests can run in parallel.")
  (cases
    (item
      (name create_order_success)
      (setup
        (mock_services
          (product_service
            (item
              (method GET)
              (path "/products/prod-001")
              (response
                (status 200)
                (body
                  (id prod-001)
                  (name Widget)
                  (price 9.99)
                  (stock 100))))
            (item
              (method GET)
              (path "/products/prod-002")
              (response
                (status 200)
                (body
                  (id prod-002)
                  (name Gadget)
                  (price 19.99)
                  (stock 50)))))))
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "John Doe")
            (items
              (item
                (product_id prod-001)
                (quantity 2))
              (item
                (product_id prod-002)
                (quantity 1)))))
        (item
          (assert status)
          (equals 201))
        (item
          (assert body.customer_name)
          (equals "John Doe"))
        (item
          (assert body.items.length)
          (equals 2))
        (item
          (assert body.total)
          (equals 39.97))
        (item
          (assert body.status)
          (equals pending))
        (item
          (assert body.id)
          (exists true)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_insufficient_stock)
      (setup
        (mock_services
          (product_service
            (item
              (method GET)
              (path "/products/prod-001")
              (response
                (status 200)
                (body
                  (id prod-001)
                  (name Widget)
                  (price 9.99)
                  (stock 2)))))))
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "Jane Doe")
            (items
              (item
                (product_id prod-001)
                (quantity 10)))))
        (item
          (assert status)
          (equals 422))
        (item
          (assert body.error.type)
          (equals INSUFFICIENT_STOCK)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_product_not_found)
      (setup
        (mock_services
          (product_service
            (item
              (method GET)
              (path "/products/nonexistent-id")
              (response
                (status 404)
                (body
                  (error
                    (type NOT_FOUND))))))))
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "Jane Doe")
            (items
              (item
                (product_id nonexistent-id)
                (quantity 1)))))
        (item
          (assert status)
          (equals 404))
        (item
          (assert body.error.type)
          (equals NOT_FOUND)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name cancel_order_success)
      (setup
        (seed_data
          (order_store
            (item
              (id order-to-cancel)
              (customer_name "Cancel Test")
              (items
                (item
                  (product_id prod-001)
                  (product_name Widget)
                  (quantity 1)
                  (unit_price 9.99)
                  (subtotal 9.99)))
              (total 9.99)
              (status pending)
              (created_at "2026-04-14T00:00:00Z")))))
      (run
        (item
          (action REQUEST)
          (method PUT)
          (path "/orders/order-to-cancel/cancel")
          (auth true))
        (item
          (assert status)
          (equals 200))
        (item
          (assert body.status)
          (equals cancelled)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name cancel_already_cancelled_order)
      (setup
        (seed_data
          (order_store
            (item
              (id already-cancelled)
              (customer_name "Already Cancelled")
              (items
                (item
                  (product_id prod-001)
                  (product_name Widget)
                  (quantity 1)
                  (unit_price 9.99)
                  (subtotal 9.99)))
              (total 9.99)
              (status cancelled)
              (created_at "2026-04-14T00:00:00Z")))))
      (run
        (item
          (action REQUEST)
          (method PUT)
          (path "/orders/already-cancelled/cancel")
          (auth true))
        (item
          (assert status)
          (equals 422))
        (item
          (assert body.error.type)
          (equals ORDER_NOT_CANCELLABLE)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_unauthorized)
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth false)
          (body
            (customer_name "No Auth")
            (items
              (item
                (product_id prod-001)
                (quantity 1)))))
        (item
          (assert status)
          (equals 401)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_empty_items)
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "Empty Order")
            (items )))
        (item
          (assert status)
          (equals 400)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_product_service_timeout)
      (setup
        (mock_services
          (product_service
            (item
              (method GET)
              (path "/products/slow-product")
              (response
                (delay_ms 5000)
                (status 200)
                (body))
              (_comment "Simulates timeout — delay exceeds policy timeout of 3000ms")))))
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "Timeout Test")
            (items
              (item
                (product_id slow-product)
                (quantity 1)))))
        (item
          (assert status)
          (equals 504))
        (item
          (assert body.error.type)
          (equals TIMEOUT)))
      (clean "RESET_STORE(order_store)"))
    (item
      (name create_order_circuit_breaker_open)
      (setup
        (force_circuit_state
          (product_service_policy OPEN)))
      (run
        (item
          (action REQUEST)
          (method POST)
          (path "/orders")
          (auth true)
          (body
            (customer_name "Circuit Open Test")
            (items
              (item
                (product_id any-product)
                (quantity 1)))))
        (item
          (assert status)
          (equals 503))
        (item
          (assert body.error.type)
          (equals UNAVAILABLE)))
      (clean "RESET_STORE(order_store)" "RESET_CIRCUIT(product_service_policy)"))
    (item
      (name get_order_not_found)
      (run
        (item
          (action REQUEST)
          (method GET)
          (path "/orders/00000000-0000-0000-0000-000000000000"))
        (item
          (assert status)
          (equals 404))
        (item
          (assert body.error.type)
          (equals NOT_FOUND))))
    (item
      (name list_orders_empty)
      (run
        (item
          (action REQUEST)
          (method GET)
          (path "/orders"))
        (item
          (assert status)
          (equals 200))
        (item
          (assert body.length)
          (equals 0))))))
