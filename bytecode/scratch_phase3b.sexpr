;; Scratch service — v0.9 phase 3b validator.
;; Exercises field access on a CALL_SERVICE result:
;;   * numeric fields in COMPUTE (price * quantity)
;;   * string field in MATCH case dispatch
;;   * nested dotted path in CONSTRUCT
;;
;; The remote service's payload shape is unknown at compile time, so the
;; C# backend keeps result as JsonNode? and the Go backend keeps it as
;; map[string]any. Phase 3b teaches the codegen how to read fields.

(service scratch_jsonnode
  (version "0.9-phase3b")
  (port 8098))

(schema PriceCheckRequest
  (field product_id string (required))
  (field quantity   int    (required) (gt 0)))

(schema PriceCheckResponse
  (field product_id string (required))
  (field unit_price decimal (required))
  (field subtotal   decimal (required))
  (field in_stock   bool    (required)))

(config
  (jwt_secret secret "JWT_SECRET"))

(auth
  (provider jwt)
  (secret_ref jwt_secret))

(cors
  (origins "*")
  (methods POST)
  (headers "Content-Type" "Authorization")
  (max_age 3600))

(dependencies
  (product_service
    (type SERVICE_REF)
    (target product_service)
    (base_url_ref ENV.PRODUCT_SERVICE_URL)
    (default "http://localhost:8080")))

(route POST "/check-price" handler_check_price)

(handler handler_check_price
  (auth (requires authenticated))
  (returns (RESULT PriceCheckResponse Error))
  (do
    (READ_BODY PriceCheckRequest → body)
    (MATCH body
      (ERR (ERR_INVALID_BODY "PriceCheckRequest"))
      (OK
        (CALL_SERVICE product_service
          (method GET)
          (path "/products/{body.product_id}")
          (idempotent true)
          → product_result)
        (MATCH product_result
          (NONE (ERR_NOT_FOUND "product" body.product_id))
          (OK
            ;; Numeric field access on JsonNode — the real Phase 3b exercise.
            (COMPUTE product_result.price * body.quantity → subtotal)
            ;; Nested CONSTRUCT pulling fields from the remote payload + computed locals.
            (CONSTRUCT PriceCheckResponse
              (product_id   product_result.id)
              (unit_price   product_result.price)
              (subtotal     subtotal)
              (in_stock     product_result.active)
              → resp)
            (RESPOND 200 resp)))))))
